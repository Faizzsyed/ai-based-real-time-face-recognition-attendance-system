# Phase 15 - Production & Local Template
# Do not place real credentials in this file.

# Environment: "development" | "production"
APP_ENV=development
APP_NAME=AI Based Real-Time Face Recognition Attendance System

# Backend bind (local development). For containers/public servers use 0.0.0.0.
# Production launchers accept API_HOST and PORT > API_PORT > 8000 from process environment.
API_HOST=127.0.0.1
API_PORT=8000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DATABASE=attendai_python_dev
# Render cloud-test configuration uses true and attendai_cloud_test instead.
CLOUD_TEST_MODE=false

# Security & Secrets (Required secure strings in production)
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Security - CORS
# In production, must be explicitly defined, e.g., "https://attendance.example.com"
# Empty disables cross-origin browser access. Native Android/desktop HTTP clients do not use browser CORS.
CORS_ORIGINS=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
ENABLE_API_REQUEST_LOGGING=true
ENABLE_FILE_LOGGING=false
ENABLE_UI_EVENT_LOGGING=true

# Biometric / AI Settings
FACE_AI_ENABLED=false
# auto: local development files; MongoDB GridFS in production.
FACE_REFERENCE_STORAGE=auto
# Required if FACE_AI_ENABLED=true in production (must be exactly 32 chars)
FACE_EMBEDDING_ENCRYPTION_KEY=replace_with_exactly_32_random_characters

# Paths to models
FACE_DETECTION_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
FACE_RECOGNITION_MODEL_PATH=models/face_recognition_sface_2021dec.onnx

# Thresholds
FACE_DETECTION_THRESHOLD=0.90
FACE_MATCH_THRESHOLD=0.363
FACE_IDENTIFICATION_MIN_MARGIN=0.08
FACE_ENROLLMENT_CONSISTENCY_THRESHOLD=0.40
FACE_RECOGNITION_COOLDOWN_SECONDS=8
FACE_LIVENESS_MODE=optional
FACE_MAX_IMAGE_BYTES=5242880
ATTENDANCE_LOW_THRESHOLD_PERCENT=75

# Desktop Client / Biometrics
CAMERA_PREVIEW_FPS=24
CAMERA_ANALYSIS_FPS=6
CAMERA_ANALYSIS_WIDTH=640
FACE_STABILITY_SECONDS=1.0
FACE_LIVENESS_REQUIRED_BLINKS=1
FACE_LIVENESS_TIMEOUT_SECONDS=9
FACE_LIVENESS_MIN_OPEN_FRAMES=2
FACE_LIVENESS_MIN_CLOSED_FRAMES=2
FACE_LIVENESS_CALIBRATION_SAMPLES=8
FACE_LIVENESS_CLOSURE_DELTA=0.20
FACE_LIVENESS_REOPEN_RATIO=0.45
FACE_LIVENESS_ANALYSIS_FPS=15
FACE_LIVENESS_DEBUG=false
FACE_ENROLLMENT_CAPTURE_INTERVAL_SECONDS=0.50
FACE_ENROLLMENT_MAX_CAPTURE_RETRIES=8
FACE_LIVENESS_CHALLENGE_MODE=challenge
FACE_LIVENESS_ENROLLMENT_STEPS=1
FACE_LIVENESS_ATTENDANCE_STEPS=1
FACE_LIVENESS_POSE_TIMEOUT_SECONDS=9
FACE_LIVENESS_POSE_DELTA=0.10
FACE_LIVENESS_POSE_CENTER_TOLERANCE=0.07
FACE_LIVENESS_POSE_FRAMES=3
# Set only if the camera/driver delivers horizontally reflected analysis frames.
# Preview-only mirroring must leave this false.
CAMERA_INPUT_MIRRORED=false
FACE_LIVENESS_FACE_LOSS_GRACE_MS=600

# Desktop client configuration: process environment > .env > local default.
# For production set APP_ENV=production and API_BASE_URL=https://api.example.com.
# Android embeds -ApiUrl through scripts/build_android.ps1; it does not read this file.
# Never place backend MongoDB/JWT secrets in the app directory or Android payload.
API_BASE_URL=http://127.0.0.1:8000
ALLOW_INSECURE_DEV_API=true
ENABLE_DEV_ACADEMIC_API=false
ENABLE_DEV_ROLE_PREVIEW=true
